<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | BlogHub</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link href="https://unicons.iconscout.com/release/v4.0.8/css/line.css" rel="stylesheet">
</head>
<body>

<!-- Modern Blog Header -->
<style>
  * {
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  /* Dark Mode Variables */
  :root {
    --bg-primary: #f8f9fc;
    --bg-secondary: #ffffff;
    --text-primary: #0b1020;
    --text-secondary: #5c6074;
    --border-color: #e9eaf3;
  }

  body.dark {
    --bg-primary: #0f1419;
    --bg-secondary: #1a1f2e;
    --text-primary: #e4e7eb;
    --text-secondary: #98a2b3;
    --border-color: #2d3748;
  }

  body {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .blog-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  body.dark .blog-header {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .blog-header .header-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    gap: 20px;
  }

  .blog-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .blog-brand:hover {
    transform: translateY(-2px);
  }

  .blog-logo {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    display: grid;
    place-items: center;
    color: white;
    font-weight: 800;
    font-size: 20px;
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.3);
  }

  .blog-brand-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .blog-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    flex: 1;
    justify-content: center;
  }

  .blog-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 15px;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.3s;
    position: relative;
  }

  .blog-nav a:hover {
    color: #5a5df5;
    background: #eef0ff;
  }

  body.dark .blog-nav a:hover {
    background: rgba(90, 93, 245, 0.1);
  }

  .blog-nav a.active {
    color: #5a5df5;
    background: #eef0ff;
  }

  body.dark .blog-nav a.active {
    background: rgba(90, 93, 245, 0.1);
  }

  .blog-nav a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, #5a5df5, #9a6bff);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: #f7f7fb;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  body.dark .user-menu {
    background: rgba(255, 255, 255, 0.05);
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    display: grid;
    place-items: center;
    color: white;
    font-weight: 700;
    font-size: 14px;
  }

  .user-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 14px;
  }

  .header-btn {
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
  }

  .btn-login {
    background: transparent;
    color: #5a5df5;
    border: 1px solid var(--border-color);
  }

  .btn-login:hover {
    background: #eef0ff;
    border-color: #5a5df5;
  }

  .btn-signup {
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    color: white;
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.3);
  }

  .btn-signup:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(90, 93, 245, 0.4);
  }

  .btn-logout {
    background: #f7f7fb;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  body.dark .btn-logout {
    background: rgba(255, 255, 255, 0.05);
  }

  .btn-logout:hover {
    background: #ffe1e1;
    color: #e74c3c;
    border-color: #e74c3c;
  }

  .mobile-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-color);
    background: transparent;
    border-radius: 10px;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all 0.3s;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .blog-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-secondary);
      flex-direction: column;
      padding: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      display: none;
      gap: 8px;
    }

    .blog-nav.active {
      display: flex;
    }

    .blog-nav a {
      width: 100%;
      text-align: center;
      padding: 12px;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .header-actions {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-secondary);
      flex-direction: column;
      padding: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      display: none;
      margin-top: 1px;
    }

    .header-actions.active {
      display: flex;
    }

    .user-menu {
      width: 100%;
      justify-content: center;
    }

    .header-btn {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .blog-header .header-container {
      padding: 12px 16px;
    }

    .blog-brand-text {
      display: none;
    }
  }
</style>

<header class="blog-header">
  <div class="header-container">
    <a href="/" class="blog-brand">
      <div class="blog-logo">B</div>
      <span class="blog-brand-text">BlogHub</span>
    </a>

    <nav class="blog-nav" id="blogNav">
      <a href="/" class="<%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>">Home</a>
      <% if (session.user) { %>
        <% if (session.user.role === 'admin') { %>
          <a href="/admin" class="<%= typeof currentPage !== 'undefined' && currentPage === 'admin' ? 'active' : '' %>">Dashboard</a>
        <% } else if (session.user.role === 'author') { %>
          <a href="/author" class="<%= typeof currentPage !== 'undefined' && currentPage === 'author' ? 'active' : '' %>">My Posts</a>
        <% } else { %>
          <a href="/user" class="<%= typeof currentPage !== 'undefined' && currentPage === 'user' ? 'active' : '' %>">Explore</a>
        <% } %>
      <% } %>
      <a href="/#featured">Featured</a>
      <a href="/#categories">Categories</a>
    </nav>

    <div class="header-actions" id="headerActions">
      <% if (session.user) { %>
        <div class="user-menu">
          <div class="user-avatar"><%= session.user.name.charAt(0).toUpperCase() %></div>
          <span class="user-name"><%= session.user.name %></span>
        </div>
        <a href="/logout" class="header-btn btn-logout">
          <i class="fas fa-sign-out-alt"></i> Logout
        </a>
      <% } else { %>
        <a href="/login" class="header-btn btn-login">Login</a>
        <a href="/signup" class="header-btn btn-signup">Get Started</a>
      <% } %>
    </div>

    <button class="mobile-menu-btn" id="mobileMenuBtn">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="content-wrapper">

<!-- Modern Sidebar Styles -->
<style>
  .sidebar {
    position: fixed;
    top: 90px;
    left: 0;
    height: calc(100vh - 90px);
    width: 260px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: 2px 0 12px rgba(0, 0, 0, 0.04);
    z-index: 100;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body.dark .sidebar {
    box-shadow: 2px 0 12px rgba(0, 0, 0, 0.3);
  }

  .sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: #d0d5dd;
    border-radius: 10px;
  }

  .sidebar::-webkit-scrollbar-thumb:hover {
    background: #98a2b3;
  }

  .sidebar-header {
    padding: 24px 20px;
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
  }

  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sidebar-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    display: grid;
    place-items: center;
    color: white;
    font-weight: 800;
    font-size: 20px;
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.25);
  }

  .sidebar-user-info h5 {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .sidebar-user-info h5 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .sidebar-user-info h5 a:hover {
    color: #5a5df5;
  }

  .sidebar-user-role {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 4px 0 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  body.dark .sidebar-user-info h5,
  body.dark .sidebar-user-role {
    color: var(--text-primary);
  }

  .sidebar-search {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-search-input {
    width: 100%;
    padding: 10px 16px;
    padding-left: 40px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-primary);
    font-size: 14px;
    color: var(--text-primary);
    transition: all 0.3s;
  }

  .sidebar-search-wrapper {
    position: relative;
  }

  .sidebar-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    font-size: 14px;
  }

  .sidebar-search-input:focus {
    outline: none;
    border-color: #5a5df5;
    background: var(--bg-secondary);
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.1);
  }

  .sidebar-search-input::placeholder {
    color: var(--text-secondary);
  }

  .sidebar-nav {
    padding: 12px 0;
  }

  .sidebar-nav-section {
    margin-bottom: 24px;
  }

  .sidebar-nav-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    padding: 12px 20px 8px;
    margin: 0;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-nav li {
    margin: 0;
  }

  .sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s;
    position: relative;
  }

  .sidebar-nav a i {
    font-size: 18px;
    width: 24px;
    text-align: center;
    transition: transform 0.3s;
  }

  .sidebar-nav a:hover {
    background: var(--bg-primary);
    color: #5a5df5;
  }

  .sidebar-nav a:hover i {
    transform: translateX(2px);
  }

  .sidebar-nav a.active {
    background: linear-gradient(90deg, rgba(90, 93, 245, 0.1) 0%, transparent 100%);
    color: #5a5df5;
    border-left: 3px solid #5a5df5;
    font-weight: 700;
  }

  .sidebar-nav a.logout-link {
    margin-top: 20px;
    color: #e74c3c;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
  }

  .sidebar-nav a.logout-link:hover {
    background: #fff5f5;
    color: #c0392b;
  }

  body.dark .sidebar-nav a.logout-link:hover {
    background: rgba(231, 76, 60, 0.1);
  }

  .nav-badge {
    margin-left: auto;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    color: white;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 12px;
    min-width: 20px;
    text-align: center;
  }

  .nav-badge.success {
    background: linear-gradient(135deg, #27ae60, #2ecc71);
  }

  .sidebar-collapse {
    display: none;
    position: absolute;
    top: 20px;
    right: -40px;
    width: 32px;
    height: 32px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
  }

  .sidebar-collapse:hover {
    background: #5a5df5;
    color: white;
    border-color: #5a5df5;
  }

  @media (max-width: 968px) {
    .sidebar {
      transform: translateX(-100%);
    }

    .sidebar.active {
      transform: translateX(0);
    }

    .sidebar-collapse {
      display: flex;
    }
  }
</style>

<aside class="sidebar" id="mainSidebar">
  <button class="sidebar-collapse" id="sidebarToggle">
    <i class="fas fa-bars"></i>
  </button>

  <div class="sidebar-header">
    <div class="sidebar-user">
      <div class="sidebar-avatar">
        <%= session.user.name.charAt(0).toUpperCase() %>
      </div>
      <div class="sidebar-user-info">
        <h5><a href="#"><%= session.user.name %></a></h5>
        <p class="sidebar-user-role">
          <% if (session.user.role === 'admin') { %>
            Administrator
          <% } else if (session.user.role === 'author') { %>
            Author
          <% } else { %>
            User
          <% } %>
        </p>
      </div>
    </div>
  </div>

  <div class="sidebar-search">
    <div class="sidebar-search-wrapper">
      <i class="fas fa-search sidebar-search-icon"></i>
      <input 
        type="text" 
        class="sidebar-search-input" 
        placeholder="Search..."
        id="sidebarSearch"
      />
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-nav-section">
      <h6 class="sidebar-nav-title">Main</h6>
      <ul>
        <li>
          <a href="/<%= session.user.role %>" class="<%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">
            <i class="uil uil-estate"></i>
            <span>Dashboard</span>
          </a>
        </li>
        
        <% if (session.user.role === 'admin') { %>
          <li>
            <a href="/admin/users">
              <i class="uil uil-users-alt"></i>
              <span>Manage Users</span>
            </a>
          </li>
          <li>
            <a href="/admin/blogs">
              <i class="uil uil-book"></i>
              <span>Manage Blogs</span>
            </a>
          </li>
        <% } %>

        <% if (session.user.role === 'author') { %>
          <li>
            <a href="/author/create">
              <i class="uil uil-plus-circle"></i>
              <span>Create Post</span>
              <span class="nav-badge success">New</span>
            </a>
          </li>
          <li>
            <a href="/author">
              <i class="uil uil-book-alt"></i>
              <span>My Posts</span>
            </a>
          </li>
        <% } %>

        <% if (session.user.role === 'user') { %>
          <li>
            <a href="/user">
              <i class="uil uil-book-open"></i>
              <span>Explore Blogs</span>
            </a>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="sidebar-nav-section">
      <h6 class="sidebar-nav-title">Tools</h6>
      <ul>
        <li>
          <a href="/calendar">
            <i class="uil uil-calendar-alt"></i>
            <span>Calendar</span>
          </a>
        </li>
        <% if (session.user.role !== 'user') { %>
          <li>
            <a href="#">
              <i class="uil uil-chart-pie-alt"></i>
              <span>Analytics</span>
            </a>
          </li>
        <% } %>
        <li>
          <a href="/map">
            <i class="uil uil-map-marker"></i>
            <span>Maps</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-nav-section">
      <h6 class="sidebar-nav-title">Settings</h6>
      <ul>
        <li>
          <a href="/settings">
            <i class="uil uil-setting"></i>
            <span>Settings</span>
          </a>
        </li>
        <li>
          <a href="#" id="themeToggle">
            <i class="uil uil-moon"></i>
            <span>Dark Mode</span>
          </a>
        </li>
        <li>
          <a href="/logout" class="logout-link">
            <i class="fas fa-sign-out-alt"></i>
            <span>Logout</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</aside>

<!-- Main Content -->
<style>
  .main-content {
    margin-left: 260px;
    padding: 30px;
    min-height: calc(100vh - 90px);
    background: var(--bg-primary);
    transition: all 0.3s;
  }

  @media (max-width: 968px) {
    .main-content {
      margin-left: 0;
    }
  }

  /* Welcome Section */
  .welcome {
    background: var(--bg-secondary);
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    margin-bottom: 24px;
    border-left: 4px solid #5a5df5;
  }

  body.dark .welcome {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .welcome h1 {
    font-size: 32px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .welcome p {
    font-size: 16px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Metrics Grid */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .metric-card {
    background: var(--bg-secondary);
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.3s;
  }

  body.dark .metric-card {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .metric-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .metric-card .icon {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: white;
    font-size: 28px;
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.3);
  }

  .metric-card.users .icon { background: linear-gradient(135deg, #5a5df5, #9a6bff); }
  .metric-card.blogs .icon { background: linear-gradient(135deg, #27ae60, #2ecc71); }
  .metric-card.published .icon { background: linear-gradient(135deg, #e74c3c, #c0392b); }
  .metric-card.comments .icon { background: linear-gradient(135deg, #f39c12, #e67e22); }

  .metric-card h3 {
    font-size: 28px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .metric-card p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Quick Actions */
  .quick-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .action-btn {
    padding: 16px 32px;
    background: linear-gradient(135deg, #5a5df5, #9a6bff);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s;
    box-shadow: 0 4px 12px rgba(90, 93, 245, 0.3);
  }

  .action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(90, 93, 245, 0.4);
  }

  .action-btn.secondary {
    background: linear-gradient(135deg, #27ae60, #2ecc71);
    box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
  }

  .action-btn.secondary:hover {
    box-shadow: 0 6px 20px rgba(39, 174, 96, 0.4);
  }

  /* Charts */
  .charts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  @media (max-width: 968px) {
    .charts {
      grid-template-columns: 1fr;
    }
  }

  .chart {
    background: var(--bg-secondary);
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  body.dark .chart {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .chart h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .chart p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .chart canvas {
    width: 100% !important;
    height: 300px !important;
  }

  /* System Info */
  .system-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-box {
    background: var(--bg-secondary);
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    text-align: center;
    transition: all 0.3s;
  }

  body.dark .info-box {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .info-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .info-box i {
    font-size: 48px;
    margin-bottom: 16px;
    display: block;
  }

  .info-box.primary i { color: #5a5df5; }
  .info-box.success i { color: #27ae60; }
  .info-box.danger i { color: #e74c3c; }
  .info-box.warning i { color: #f39c12; }
  .info-box.purple i { color: #9b59b6; }
  .info-box.dark-color i { color: #34495e; }

  .info-box h3 {
    font-size: 32px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .info-box p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  .info-box a {
    text-decoration: none;
    color: #5a5df5;
    font-weight: 700;
    font-size: 16px;
  }

  /* Last Chart */
  .lastchart {
    background: var(--bg-secondary);
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  body.dark .lastchart {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .lastchart h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .lastchart p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .lastchart canvas {
    width: 100% !important;
    height: 400px !important;
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 20px;
    }

    .charts {
      grid-template-columns: 1fr;
    }

    .quick-actions {
      flex-direction: column;
    }

    .action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<div class="main-content">
  <!-- Welcome -->
  <div class="welcome">
    <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
    <p>Hello <%= session.user.name %>, manage your blog platform here!</p>
  </div>

  <!-- Metrics -->
  <div class="metrics">
    <div class="metric-card users">
      <div class="icon"><i class="fas fa-users"></i></div>
      <div>
        <h3><%= stats.total_users %></h3>
        <p>Total Users</p>
      </div>
    </div>
    <div class="metric-card blogs">
      <div class="icon"><i class="fas fa-book"></i></div>
      <div>
        <h3><%= stats.total_blogs %></h3>
        <p>All Blog Posts</p>
      </div>
    </div>
    <div class="metric-card published">
      <div class="icon"><i class="fas fa-check-circle"></i></div>
      <div>
        <h3><%= stats.published_blogs %></h3>
        <p>Published Blogs</p>
      </div>
    </div>
    <div class="metric-card comments">
      <div class="icon"><i class="fas fa-comments"></i></div>
      <div>
        <h3><%= stats.total_comments %></h3>
        <p>User Comments</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions">
    <a href="/admin/users" class="action-btn">
      <i class="fas fa-users"></i> Manage Users
    </a>
    <a href="/admin/blogs" class="action-btn secondary">
      <i class="fas fa-book"></i> Manage Blogs
    </a>
  </div>

  <!-- Charts -->
  <div class="charts">
    <div class="chart">
      <h3>Monthly Activity</h3>
      <p>User activity over the months</p>
      <canvas id="myChart"></canvas>
    </div>
    <div class="chart">
      <h3>Blog Performance</h3>
      <p>Engagement trends</p>
      <canvas id="myChart2"></canvas>
    </div>
  </div>

  <!-- System Info -->
  <div class="system-info">
    <div class="info-box primary">
      <i class="fas fa-shield-alt"></i>
      <h3>Admin</h3>
      <p>System Control</p>
    </div>
    <div class="info-box success">
      <i class="fas fa-users"></i>
      <h3><%= stats.total_users %></h3>
      <p>Total Users</p>
    </div>
    <div class="info-box danger">
      <i class="fas fa-book"></i>
      <h3><%= stats.total_blogs %></h3>
      <p>Total Blogs</p>
    </div>
    <div class="info-box warning">
      <i class="fas fa-check-circle"></i>
      <h3><%= stats.published_blogs %></h3>
      <p>Published</p>
    </div>
    <div class="info-box purple">
      <i class="fas fa-comments"></i>
      <h3><%= stats.total_comments %></h3>
      <p>Comments</p>
    </div>
    <div class="info-box dark-color">
      <i class="fas fa-cog"></i>
      <a href="/admin/users">Manage System</a>
    </div>
  </div>

  <!-- Engagement Chart -->
  <div class="lastchart">
    <h3>User Engagement Trends</h3>
    <p>Track platform activity over time</p>
    <canvas id="myChart3"></canvas>
  </div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // ============================================
  // TO USE REAL DATA FROM YOUR BACKEND:
  // Replace the hardcoded data arrays with EJS variables from your route
  // Example in your route: res.render('admin', { stats, monthlyData, weeklyData })
  // Then use: data: <%- JSON.stringify(monthlyData.users) %>
  // ============================================

  // Chart 1 - Monthly Activity (You can pass real data from backend)
  const ctx = document.getElementById('myChart');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September'],
      datasets: [{
        label: 'New Users',
        data: [12, 19, 3, 5, 2, 3, 7, 14, 8], // Replace with: <%- JSON.stringify(monthlyData.users) %>
        backgroundColor: "#0d6efd",
        borderColor: 'transparent',
        borderWidth: 2.5,
        barPercentage: 0.4,
      }, {
        label: "New Blogs",
        data: [20, 40, 20, 50, 25, 40, 25, 10, 30], // Replace with: <%- JSON.stringify(monthlyData.blogs) %>
        backgroundColor: "#dc3545",
        borderColor: 'transparent',
        borderWidth: 2.5,
        barPercentage: 0.4,
      }]
    },
    options: {
      scales: {
        yAxes: [{
          gridLines: {},
          ticks: {
            stepSize: 15,
          },
        }],
        xAxes: [{
          gridLines: {
            display: false,
          }
        }]
      }
    }
  });

  // Chart 2 - Blog Performance
  const ctx2 = document.getElementById('myChart2');
  new Chart(ctx2, {
    type: 'line',
    data: {
      labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September'],
      datasets: [{
        label: 'Likes',
        data: [12, 19, 13, 25, 22, 33, 37, 44, 52], // Replace with real data
        backgroundColor: 'transparent',
        borderColor: '#0d6efd',
        lineTension: .4,
        borderWidth: 1.5,
      }, {
        label: "Comments",
        data: [6, 10, 8, 15, 12, 18, 21, 25, 28], // Replace with real data
        backgroundColor: 'transparent',
        borderColor: '#f0ad4e',
        lineTension: .4,
        borderWidth: 1.5,
      }]
    },
    options: {
      scales: {
        yAxes: [{
          gridLines: {
            drawBorder: false
          },
          ticks: {
            stepSize: 12,
          }
        }],
        xAxes: [{
          gridLines: {
            display: false,
          },
        }]
      }
    }
  });

  // Chart 3 - User Engagement
  const ctx3 = document.getElementById('myChart3');
  new Chart(ctx3, {
    type: 'line',
    data: {
      labels: ["Week 1", "Week 2", "Week 3", "Week 4", "Week 5", "Week 6", "Week 7", "Week 8"],
      datasets: [
        {
          label: "New Users",
          lineTension: 0.2,
          borderColor: '#d9534f',
          borderWidth: 1.5,
          data: [3, 8, 12, 18, 22, 28, 32, 40], // Replace with real data
          backgroundColor: 'transparent',
        },
        {
          label: "Active Authors",
          lineTension: 0.2,
          borderColor: '#5cb85c',
          borderWidth: 1.5,
          data: [2, 4, 6, 8, 10, 14, 18, 22], // Replace with real data
          backgroundColor: 'transparent',
        },
        {
          label: "New Blogs",
          lineTension: 0.2,
          borderColor: '#f0ad4e',
          borderWidth: 1.5,
          data: [5, 12, 18, 22, 28, 35, 40, 48], // Replace with real data
          backgroundColor: 'transparent',
        },
        {
          label: "Comments",
          lineTension: 0.2,
          borderColor: '#337ab7',
          borderWidth: 1.5,
          data: [8, 15, 20, 28, 35, 42, 50, 60], // Replace with real data
          backgroundColor: 'transparent',
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          grid: {
            drawBorder: false,
          },
          ticks: {
            stepSize: 12,
          },
        },
        x: {
          grid: {
            display: false,
          },
        },
      },
    },
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const blogNav = document.getElementById('blogNav');
  const headerActions = document.getElementById('headerActions');

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenuBtn.classList.toggle('active');
      blogNav.classList.toggle('active');
      headerActions.classList.toggle('active');
    });
  }

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.blog-header')) {
      mobileMenuBtn?.classList.remove('active');
      blogNav?.classList.remove('active');
      headerActions?.classList.remove('active');
    }
  });

  // Sidebar toggle
  const sidebarToggle = document.getElementById('sidebarToggle');
  const mainSidebar = document.getElementById('mainSidebar');

  if (sidebarToggle) {
    sidebarToggle.addEventListener('click', () => {
      mainSidebar.classList.toggle('active');
    });
  }

  document.addEventListener('click', (e) => {
    if (window.innerWidth <= 968) {
      if (!e.target.closest('.sidebar') && !e.target.closest('.sidebar-collapse')) {
        mainSidebar?.classList.remove('active');
      }
    }
  });

  // Search functionality
  const sidebarSearch = document.getElementById('sidebarSearch');
  if (sidebarSearch) {
    sidebarSearch.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase();
      const navLinks = document.querySelectorAll('.sidebar-nav a');
      
      navLinks.forEach(link => {
        const text = link.textContent.toLowerCase();
        const listItem = link.parentElement;
        
        if (text.includes(searchTerm)) {
          listItem.style.display = 'block';
        } else {
          listItem.style.display = 'none';
        }
      });

      document.querySelectorAll('.sidebar-nav-section').forEach(section => {
        const visibleLinks = section.querySelectorAll('li[style="display: block;"], li:not([style])');
        if (visibleLinks.length === 0 || (searchTerm && visibleLinks.length === 0)) {
          section.style.display = 'none';
        } else {
          section.style.display = 'block';
        }
      });
    });
  }

  // Dark Mode Toggle
  const themeToggle = document.getElementById('themeToggle');
  
  // Load saved theme
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark');
    updateThemeIcon(true);
  }
  
  if (themeToggle) {
    themeToggle.addEventListener('click', (e) => {
      e.preventDefault();
      
      const isDark = document.body.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeIcon(isDark);
    });
  }
  
  function updateThemeIcon(isDark) {
    const icon = themeToggle?.querySelector('i');
    const text = themeToggle?.querySelector('span');
    
    if (icon) {
      icon.className = isDark ? 'uil uil-sun' : 'uil uil-moon';
    }
    
    if (text) {
      text.textContent = isDark ? 'Light Mode' : 'Dark Mode';
    }
  }

  // Highlight active page
  const currentPath = window.location.pathname;
  document.querySelectorAll('.sidebar-nav a').forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
</script>

</body>
</html>