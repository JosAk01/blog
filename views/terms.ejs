<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terms of Service | BlogHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-dark: #1a1a1a;
            --text-primary: #2d2d2d;
            --text-secondary: #666;
            --accent: #d4a373;
            --bg-cream: #faf8f5;
            --border-light: #e5e5e5;
        }

        body {
            font-family: 'Work Sans', sans-serif;
            line-height: 1.7;
            color: var(--text-primary);
            background: var(--bg-cream);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 24px;
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        header {
            text-align: center;
            margin-bottom: 60px;
            padding-bottom: 40px;
            border-bottom: 2px solid var(--accent);
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 16px;
            letter-spacing: -0.02em;
            animation: slideDown 0.6s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .last-updated {
            font-size: 0.95rem;
            color: var(--text-secondary);
            font-style: italic;
        }

        .intro {
            font-size: 1.15rem;
            color: var(--text-secondary);
            margin-bottom: 48px;
            padding: 24px;
            background: white;
            border-left: 4px solid var(--accent);
            border-radius: 4px;
        }

        section {
            margin-bottom: 48px;
            animation: fadeInUp 0.8s ease-out backwards;
        }

        section:nth-child(2) { animation-delay: 0.1s; }
        section:nth-child(3) { animation-delay: 0.15s; }
        section:nth-child(4) { animation-delay: 0.2s; }
        section:nth-child(5) { animation-delay: 0.25s; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 20px;
            padding-top: 20px;
        }

        h2::before {
            content: '';
            display: inline-block;
            width: 40px;
            height: 3px;
            background: var(--accent);
            margin-right: 16px;
            vertical-align: middle;
        }

        p {
            margin-bottom: 16px;
            font-size: 1.05rem;
        }

        ul {
            margin: 20px 0;
            padding-left: 24px;
        }

        li {
            margin-bottom: 12px;
            font-size: 1.05rem;
            line-height: 1.7;
        }

        li::marker {
            color: var(--accent);
            font-weight: 600;
        }

        .highlight {
            background: linear-gradient(180deg, transparent 60%, rgba(212, 163, 115, 0.3) 60%);
            padding: 0 4px;
        }

        .contact-box {
            margin-top: 60px;
            padding: 32px;
            background: white;
            border-radius: 8px;
            border: 1px solid var(--border-light);
            text-align: center;
        }

        .contact-box h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            margin-bottom: 12px;
            color: var(--primary-dark);
        }

        .contact-box a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: border-color 0.3s ease;
        }

        .contact-box a:hover {
            border-bottom-color: var(--accent);
        }

        .back-link {
            display: inline-block;
            margin-top: 40px;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .back-link:hover {
            color: var(--accent);
            transform: translateX(-5px);
        }

        .back-link::before {
            content: '← ';
        }

        @media (max-width: 768px) {
            .container {
                padding: 40px 20px;
            }

            h1 {
                font-size: 2.5rem;
            }

            h2 {
                font-size: 1.5rem;
            }

            h2::before {
                width: 30px;
                margin-right: 12px;
            }
        }
    </style>
</head>
